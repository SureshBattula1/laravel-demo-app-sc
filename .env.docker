APP_NAME="School Management"
APP_ENV=local
APP_KEY=base64:5D8Yp82sb+ogxg8S/CRg7mKMRRAaEt6B+cxLrF4W5XI=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: the "db" service in docker-compose ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=school_management
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Run bulk SMS jobs inline (no separate queue worker container in this setup).
SMS_BULK_DISPATCH_SYNC=true

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Twilio (blank locally - SMS/WhatsApp features stay inert)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=
